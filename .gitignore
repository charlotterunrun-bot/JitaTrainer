# ============================================================
# JitaTrainer .gitignore
# 原则：绝不把凭据、运行期数据、构建产物提交进仓库
# ============================================================

# --- 凭据与本地私有文件（最高优先级，绝不入库） ---
.secrets/
.tmp/
*.local.json
*.local.toml

# --- 工作区内的依赖目录（本机 pip 不可用，依赖以解包 wheel 方式放在这里） ---
.vendor/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- 构建产物（锚定根目录，避免误伤 src/ 下的同名目录） ---
/build/
/dist/
/release/
JitaTrainer.spec
*.spec.bak
*.manifest

# --- 运行期数据（绿色版数据目录，绝不入库） ---
# 注意：必须以 / 锚定根目录，否则会连 src/jitatrainer/data/ 源码一起忽略
/data/
/logs/
**/jitatrainer.db
**/jitatrainer.db-wal
**/jitatrainer.db-shm
**/backups/
**/exports/
*.log

# --- 编辑器与系统 ---
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
desktop.ini
